# ============================================================
# VILLA AMPARO — Variables de Entorno
# Copiar como .env.local y completar con valores reales
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ── Proveedor de IA (solo en Edge Functions — no exponer al cliente) ──
# Opciones: claude | openai | gemini | azure | ollama
AI_PROVIDER=claude

# Claude (Anthropic) — Recomendado
CLAUDE_API_KEY=sk-ant-...

# OpenAI (alternativa)
OPENAI_API_KEY=sk-...

# Google Gemini (alternativa económica)
GEMINI_API_KEY=AIza...

# Azure OpenAI (enterprise)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/

# Ollama (desarrollo local sin costo)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Text-to-Speech ────────────────────────────────────────────
# ElevenLabs (voz premium de Lumi)
ELEVENLABS_API_KEY=

# ── Configuración del Juego (visibles al cliente) ─────────────
VITE_GAME_VERSION=1.0.0
VITE_DEBUG_MODE=false
VITE_ENABLE_AI=true
VITE_ENABLE_PREMIUM_TTS=true

# ── Analytics (opcional) ─────────────────────────────────────
VITE_ANALYTICS_ID=
